language 0.1
package conformance.marked

/// A checkpoint an uninterrupted run passes straight through.
///
/// The event, and its position: after the node before it and before the node
/// after it. A conformance request is one run start to finish, so stopping at
/// one and continuing is not something this shape can express — see
/// Runtime 0.5 §4. What it can pin is that the marker is in the stream at all,
/// which a backend that dropped the node would fail.
agent Marked(topic: string) -> notes<markdown> {
  model requires { structured_output }

  budget {
    steps <= 2
  }

  policy {
    network deny
  }

  memory {
    working ephemeral { draft: markdown }
  }

  flow {
    state.draft = ask<markdown>("Write one line about ${topic}.")
    checkpoint "drafted"
    emit notes = state.draft
  }
}

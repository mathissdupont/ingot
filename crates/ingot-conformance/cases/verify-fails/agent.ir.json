{
  "irVersion": "0.2",
  "language": "0.2",
  "agent": "conformance.checked.Verify",
  "doc": "Bound, checked, and only then emitted.",
  "inputs": {
    "topic": "string"
  },
  "outputs": {
    "report": "artifact<markdown>"
  },
  "types": {
    "draft": {
      "fields": [
        {
          "name": "body",
          "type": "markdown"
        },
        {
          "name": "sources",
          "type": "source[]"
        }
      ]
    },
    "source": {
      "fields": [
        {
          "name": "url",
          "type": "string"
        },
        {
          "name": "title",
          "type": "string"
        }
      ]
    }
  },
  "requirements": {
    "model": {
      "mode": "capabilities",
      "capabilities": [
        "structured_output"
      ]
    }
  },
  "budget": {
    "steps": 2
  },
  "policy": {
    "network": {
      "decision": "deny"
    }
  },
  "effects": [
    "model_access"
  ],
  "entry": "n0",
  "nodes": [
    {
      "id": "n0",
      "kind": "llm.call",
      "sourceSpan": {
        "source": "main.ing",
        "start": 483,
        "end": 540
      },
      "binding": "found",
      "prompt": {
        "kind": "template",
        "parts": [
          {
            "kind": "text",
            "value": "Write about "
          },
          {
            "kind": "value",
            "value": {
              "kind": "ref",
              "scope": "input",
              "path": [
                "topic"
              ]
            },
            "type": "string"
          },
          {
            "kind": "text",
            "value": " and cite your sources."
          }
        ]
      },
      "responseType": "draft",
      "effects": [
        "model_access"
      ],
      "next": "n1"
    },
    {
      "id": "n1",
      "kind": "verify",
      "sourceSpan": {
        "source": "main.ing",
        "start": 545,
        "end": 577
      },
      "verifier": "MinSources",
      "args": [
        {
          "name": "d",
          "value": {
            "kind": "ref",
            "scope": "binding",
            "path": [
              "found"
            ]
          }
        },
        {
          "name": "min",
          "value": {
            "kind": "literal",
            "type": "int",
            "value": 2
          }
        }
      ],
      "condition": {
        "kind": "binary",
        "op": ">=",
        "lhs": {
          "kind": "builtin",
          "name": "len",
          "args": [
            {
              "kind": "ref",
              "scope": "binding",
              "path": [
                "found",
                "sources"
              ]
            }
          ]
        },
        "rhs": {
          "kind": "literal",
          "type": "int",
          "value": 2
        }
      },
      "next": "n2"
    },
    {
      "id": "n2",
      "kind": "artifact.emit",
      "sourceSpan": {
        "source": "main.ing",
        "start": 582,
        "end": 606
      },
      "value": {
        "kind": "ref",
        "scope": "binding",
        "path": [
          "found",
          "body"
        ]
      },
      "output": "report",
      "next": null
    }
  ]
}
